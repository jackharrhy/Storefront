{
  "name": "storefront",
  "private": true,
  "workspaces": [
    "packages/shared",
    "storefront-frontend",
    "storefront-discord"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "npm run build -w @storefront/shared",
    "dev": "npm run dev -w storefront-frontend",
    "dev:discord": "npm run dev -w storefront-discord",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint --deny-warnings storefront-frontend storefront-discord packages",
    "format": "oxfmt --write storefront-frontend storefront-discord packages package.json tsconfig.base.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check storefront-frontend storefront-discord packages package.json tsconfig.base.json .oxlintrc.json .oxfmtrc.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
